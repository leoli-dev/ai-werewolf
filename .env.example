# Local LLM servers — copy to `.env` and edit. Read by the game (the 「本地 LLM」
# entry in 配置 offers every server listed here, plus any added in the panel),
# the dev-server proxy, tools/llm_selfplay.ts and tools/mtplx_round_bench.py (the
# tools use the first server). After editing, refresh the page. OpenAI / DeepSeek
# are configured in the game (配置 → AI 引擎); their keys are stored encrypted in
# the browser, not here.

# OpenAI-compatible endpoint, including the port (local MTPLX by default).
LLM_BASE_URL=http://127.0.0.1:8001/v1
# Models the game offers in its picker, comma-separated, ids as listed by
# GET /v1/models. The first one is the default (and what the tools use).
# (Older .env files with a single LLM_MODEL=… still work.)
LLM_MODELS=mtplx-qwen38-27b-optimized-speed
# Optional. Stays on the dev server: the proxy adds `Authorization: Bearer …`;
# it is never bundled into the browser code.
LLM_API_KEY=

# More servers (e.g. other hosts on the LAN): the same keys with a suffix —
# _2, _3, … or a name such as _PC. Each needs LLM_BASE_URL_x and LLM_MODELS_x;
# LLM_NAME_x (label in the picker), LLM_API_KEY_x and LLM_CONCURRENCY_x are optional.
# LLM_BASE_URL_2=http://192.168.1.20:8001/v1
# LLM_MODELS_2=qwen3-32b,qwen3-14b
# LLM_NAME_2=书房 PC
# LLM_API_KEY_2=
# LLM_CONCURRENCY_2=1

# none | low | medium | high
LLM_REASONING=medium
# votes, night skills and wolf chat (short, frequent calls)
LLM_DECISION_REASONING=low

# Route browser requests through the Vite dev server (needed for local servers that refuse CORS)
LLM_USE_PROXY=true
LLM_TIMEOUT_MS=180000
# How many requests the server gets at once. Speeches always go one by one; votes,
# 上警 and 退水 are asked together and can run side by side. 1 = strictly one at a
# time (safe for a single local GPU); raise it if your server batches requests.
# Per server: LLM_CONCURRENCY_2, … (defaults to this value).
# (OpenAI / DeepSeek always get all the votes at once.)
LLM_CONCURRENCY=1
